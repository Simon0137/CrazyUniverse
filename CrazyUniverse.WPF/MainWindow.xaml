<Window x:Class="CrazyUniverse.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrazyUniverse.WPF"
        mc:Ignorable="d"
        Title="Crazy Universe" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="RobotList" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="135,10,0,0" BorderBrush="Black" Height="185" Width="150" SelectionChanged="RobotList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="DarkGray">
                        <StackPanel Orientation="Horizontal" Width="120">
                            <StackPanel Orientation="Vertical" Width="60" Margin="3, 0, 0, 0">
                                <TextBlock Text="{Binding Type}"></TextBlock>
                                <TextBlock Text="{Binding Id}" FontSize="8"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Width="50">
                                <ProgressBar Height="10" Maximum="100" Value="{Binding Charge}"></ProgressBar>
                                <ProgressBar Height="10" Maximum="100" Value="{Binding Durability}" Foreground="#FFD9B605"></ProgressBar>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="AddRobotButton" Content="Add Robot" HorizontalAlignment="Left" Margin="10,200,0,0" VerticalAlignment="Top" Width="120" Height="30" Click="AddRobotButton_Click"/>
        <Label x:Name="RobotIdLabel" Content="Robot ID" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="RobotIdBox" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" GotFocus="RobotIdBox_GotFocus" LostFocus="RobotIdBox_LostFocus"/>
        <Label x:Name="RobotTypeLabel" Content="Robot Type" HorizontalAlignment="Left" Margin="10,76,0,0" VerticalAlignment="Top" Width="120"/>
        <ComboBox x:Name="RobotTypeCombo" DisplayMemberPath="Name" HorizontalAlignment="Left" Margin="10,102,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="RobotTypeCombo_SelectionChanged"/>
        <Button x:Name="DeleteRobotButton" Content="Delete Robot" HorizontalAlignment="Left" Margin="135,200,0,0" VerticalAlignment="Top" Width="150" Height="30" IsEnabled="False" Click="DeleteRobotButton_Click"/>
        <Button x:Name="CrazyActionButton" Content="Crazy Action" HorizontalAlignment="Left" Margin="290,200,0,0" VerticalAlignment="Top" Width="150" Height="30" IsEnabled="False" Click="CrazyActionButton_Click"/>
        <Button x:Name="ChargeButton" Content="Charge" HorizontalAlignment="Left" Margin="290,10,0,0" VerticalAlignment="Top" Width="150" Height="30" Click="ChargeButton_Click" IsEnabled="False"/>
        <Button x:Name="ScanButton" Content="Scan" HorizontalAlignment="Left" Margin="290,45,0,0" VerticalAlignment="Top" Width="150" Height="30" IsEnabled="False" Click="ScanButton_Click"/>
        <Button x:Name="RepairButton" Content="Repair" HorizontalAlignment="Left" Margin="290,80,0,0" VerticalAlignment="Top" Width="150" Height="30" IsEnabled="False" Click="RepairButton_Click"/>
        <Button x:Name="ClearButton" Content="Clear selected robot" HorizontalAlignment="Left" Margin="290,165,0,0" VerticalAlignment="Top" Width="150" Height="30" IsEnabled="False" Click="ClearButton_Click"/>
        <Label x:Name="RobotTypeErrorLabel" Content="Robot Type Error" HorizontalAlignment="Left" Margin="10,124,0,0" VerticalAlignment="Top" FontSize="9" Width="120"/>
        <Label x:Name="RobotIdErrorLabel" Content="Robot Id Error" HorizontalAlignment="Left" Margin="10,54,0,0" VerticalAlignment="Top" FontSize="9" Width="120"/>
        <ListBox x:Name="LogsList" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="445,11,0,0" Width="240" Height="219" FontSize="9"/>
        <Label x:Name="TodoLabel" Content="" HorizontalAlignment="Left" Margin="290,115,0,0" VerticalAlignment="Top" Width="150"/>

    </Grid>
</Window>
